{
  "name": "flowmotion",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "typecheck": "pnpm -r typecheck",
    "test": "vitest run",
    "gen:schema": "pnpm --filter @flowmotion/core gen:schema",
    "gen:glyphs": "node --experimental-strip-types scripts/gen-glyphs.ts",
    "gen:icons": "node --experimental-strip-types scripts/gen-icons.ts"
  },
  "devDependencies": {
    "@iconify-json/carbon": "^1.2.30",
    "@iconify-json/devicon": "^1.2.82",
    "@iconify-json/lucide": "^1.2.156",
    "@iconify-json/simple-icons": "^1.2.103",
    "@types/fontkit": "^2.0.9",
    "@types/node": "^22.20.5",
    "esbuild": "^0.28.2",
    "fontkit": "^3.0.0",
    "typescript": "5.9.3",
    "vitest": "5.1.0"
  }
}
