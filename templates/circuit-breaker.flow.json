{
  "version": "2.1",
  "meta": { "title": "Circuit breaker", "summary": "How a circuit breaker stops hammering a failing service, then probes for recovery." },
  "nodes": [
    { "id": "client", "label": "Client", "kind": "actor" },
    { "id": "breaker", "label": "Circuit Breaker: CLOSED", "kind": "state", "state": "success" },
    { "id": "payments", "label": "Payments API", "kind": "service" }
  ],
  "edges": [
    { "from": "client", "to": "breaker" },
    { "from": "breaker", "to": "payments" }
  ],
  "scenarios": [
    { "id": "trip", "title": "Failures trip the breaker", "steps": [
      { "id": "healthy", "title": "Closed: calls flow", "narration": "While **closed**, every call passes straight through to Payments and the breaker just counts failures.",
        "actions": [
          { "do": "send", "from": "client", "to": "breaker", "label": "charge" },
          { "do": "send", "from": "breaker", "to": "payments", "label": "charge" },
          { "do": "state", "targets": ["payments"], "state": "success" } ] },
      { "id": "failing", "title": "Payments starts failing", "narration": "Payments begins timing out. The breaker records each failure; the threshold is 3 in a row.",
        "actions": [
          { "do": "state", "targets": ["payments"], "state": "error" },
          { "do": "send", "from": "client", "to": "breaker", "label": "charge" },
          { "do": "send", "from": "breaker", "to": "payments", "label": "charge" },
          { "do": "label", "target": "breaker", "text": "Breaker: CLOSED (3 fails)", "start": "with" },
          { "do": "state", "targets": ["breaker"], "state": "warning" } ] },
      { "id": "open", "title": "Open: fail fast", "narration": "Threshold reached, so the breaker **opens**. New calls are rejected instantly and Payments gets room to recover.",
        "actions": [
          { "do": "label", "target": "breaker", "text": "Breaker: OPEN" },
          { "do": "state", "targets": ["breaker"], "state": "error" },
          { "do": "send", "from": "client", "to": "breaker", "label": "charge" },
          { "do": "send", "from": "breaker", "to": "client", "label": "503 fast-fail" },
          { "do": "callout", "target": "breaker", "text": "No call reaches Payments", "start": "with" } ] }
    ]},
    { "id": "recover", "title": "Half-open probe succeeds",
      "branchFrom": { "scenario": "trip", "afterStep": "open" },
      "steps": [
        { "id": "half-open", "title": "Half-open: one probe", "narration": "After the cool-down the breaker goes **half-open** and lets a single probe call through.",
          "actions": [
            { "do": "label", "target": "breaker", "text": "Breaker: HALF-OPEN" },
            { "do": "state", "targets": ["breaker"], "state": "pending" },
            { "do": "state", "targets": ["payments"], "state": "success" },
            { "do": "send", "from": "breaker", "to": "payments", "label": "probe" } ] },
        { "id": "closed-again", "title": "Closed again", "narration": "The probe succeeded, so the breaker **closes** and normal traffic resumes. A failed probe would have re-opened it.",
          "actions": [
            { "do": "label", "target": "breaker", "text": "Breaker: CLOSED" },
            { "do": "state", "targets": ["breaker"], "state": "success" },
            { "do": "send", "from": "client", "to": "breaker", "label": "charge" },
            { "do": "send", "from": "breaker", "to": "payments", "label": "charge" } ] }
      ]}
  ]
}
